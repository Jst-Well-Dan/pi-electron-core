{
  "name": "pi-electron-core",
  "version": "0.2.0",
  "description": "项目级 pi 的 Electron 通用底座：RPC 通信、常驻聊天会话、模型设置（含 API Key 管理），可独立运行（npm start -- --cwd <项目目录>），也可作为库被内容层依赖组装。不含任何具体业务的技能触发或产出解析逻辑。",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jst-Well-Dan/pi-electron-core.git"
  },
  "homepage": "https://github.com/Jst-Well-Dan/pi-electron-core#readme",
  "bugs": {
    "url": "https://github.com/Jst-Well-Dan/pi-electron-core/issues"
  },
  "keywords": [
    "pi",
    "electron",
    "pi-coding-agent",
    "rpc",
    "chat",
    "lark",
    "feishu"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "src/",
    "electron/",
    "scripts/",
    "pi-packages/",
    "CORE_GUIDE.md",
    "README.md",
    "bin/"
  ],
  "scripts": {
    "start": "electron electron/main.js",
    "dev": "electron electron/main.js --dev",
    "test": "node --test test/*.test.js",
    "test:ui": "electron test/renderer-smoke.js",
    "test:installer": "node scripts/test-pi-installer.js"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "electron": "43.2.0"
  },
  "bin": {
    "pi-electron-core": "bin/pi-electron-core.js"
  }
}
